<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8620;CS8625</NoWarn>
    <ApplicationIcon>Resources\vmware.ico</ApplicationIcon>
    <AssemblyName>VmOps.NET</AssemblyName>
    <RootNamespace>VirtualizationOpsTool</RootNamespace>
    <Version>1.8.0.3</Version>
    <Authors>Virtualization Ops Team</Authors>
    <Description>虚拟化运维管理工具</Description>
    <EnableWindowsFormsHighDpi>true</EnableWindowsFormsHighDpi>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Costura.Fody 已配置，自动合并依赖DLL到exe中 -->
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 允许使用 .NET Framework 参考程序集 -->
    <DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SSH.NET" Version="2024.2.0" />
    <PackageReference Include="Fody" Version="6.8.0" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
    <!-- PS5.1 GAC 程序集引用：编译时智能提示，运行时使用系统 GAC，不打包任何 DLL -->
    <Reference Include="System.Management.Automation">
      <HintPath>C:\Windows\Microsoft.Net\assembly\GAC_MSIL\System.Management.Automation\v4.0_3.0.0.0__31bf3856ad364e35\System.Management.Automation.dll</HintPath>
    </Reference>
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationManifest Include="app.manifest" />
    <EmbeddedResource Include="scripts\linux-network-config.sh" />
    <EmbeddedResource Include="scripts\windows-network-config.ps1" />
    <EmbeddedResource Include="scripts\guestops-linux-network.sh" />
    <EmbeddedResource Include="scripts\guestops-windows-network.ps1" />
    <EmbeddedResource Include="scripts\guestops-linux-pass.sh" />
    <EmbeddedResource Include="scripts\guestops-windows-pass.ps1" />
    <EmbeddedResource Include="Resources\vmware.ico" />
    <EmbeddedResource Include="Resources\help.html" />
    <EmbeddedResource Include="Resources\update_helper.exe" />
  </ItemGroup>

  <!-- 构建前：编译 UpdateHelper 并复制到 Resources\update_helper.exe 供嵌入 -->
  <Target Name="BuildUpdateHelper" BeforeTargets="Compile" Condition="Exists('..\UpdateHelper\VirtualizationOpsTool.UpdateHelper.csproj')">
    <MSBuild Projects="..\UpdateHelper\VirtualizationOpsTool.UpdateHelper.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64" />
    <Copy SourceFiles="..\UpdateHelper\bin\$(Configuration)\net48\win-x64\update_helper.exe"
          DestinationFiles="Resources\update_helper.exe"
          Condition="Exists('..\UpdateHelper\bin\$(Configuration)\net48\win-x64\update_helper.exe')" />
  </Target>

  <Target Name="CopyAppManifest" AfterTargets="Build">
    <Copy SourceFiles="app.manifest" DestinationFiles="$(OutDir)$(AssemblyName).exe.manifest" />
  </Target>

  <Target Name="CopyToReleaseFolder" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(MSBuildThisFileDirectory)..\Releases" />
    <Copy SourceFiles="$(OutDir)$(AssemblyName).exe" DestinationFiles="$(MSBuildThisFileDirectory)..\Releases\VmOps.NET.exe" />
  </Target>

</Project>